NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/devconnect
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300

# URL du frontend (redirection après GitHub OAuth + CORS)
FRONTEND_URL=http://localhost:5173
# URL publique de l'API (utilisée pour le callback GitHub)
API_URL=http://localhost:4000

# GitHub OAuth : https://github.com/settings/developers -> New OAuth App
# Callback URL à déclarer : http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Envoi d'emails (OTP par email). Vide = les codes s'affichent dans la console en dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DevConnect <no-reply@devconnect.local>
