NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/devconnect
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300

# URL du frontend (redirection après GitHub OAuth + CORS)
FRONTEND_URL=http://localhost:5173
# URL publique de l'API (utilisée pour le callback GitHub)
API_URL=http://localhost:4000

# GitHub OAuth : https://github.com/settings/developers -> New OAuth App
# Callback URL à déclarer : http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Images envoyées : 'local' = enregistrées sur le serveur (dossier uploads/). C'est le défaut.
# Pour utiliser Cloudinary à la place : UPLOAD_DRIVER=cloudinary et les trois variables ci-dessous.
UPLOAD_DRIVER=local
# UPLOADS_DIR=./uploads

# Cloudinary (facultatif) : https://cloudinary.com -> Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Envoi d'emails (OTP par email). Vide = les codes s'affichent dans la console en dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DevConnect <no-reply@devconnect.local>

# Notes vocales : transcription Whisper (facultatif). Sans clé, les vocaux fonctionnent mais sans texte.
# OpenAI (défaut) : WHISPER_API_KEY=sk-...   |   Groq (offre gratuite) : WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions, WHISPER_MODEL=whisper-large-v3
WHISPER_API_KEY=
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_MODEL=whisper-1
# WHISPER_TIMEOUT_MS=30000
